# Dependencies
/backend/vendor/
/frontend/node_modules/
/frontend/.next/
/frontend/.vercel/
/frontend/out/

# Environment
.env
.env.local
.env.*.local
!.env.example
!.env.testing.example

# Build artifacts
/backend/storage/app/public/*
